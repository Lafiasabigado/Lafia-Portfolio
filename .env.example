# ==============================================================================
# PostHog Analytics & Dashboard Configuration
# ==============================================================================

# PostHog Project Key (public, loaded on client-side for event tracking)
NEXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-project-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# PostHog Personal API Key (server-side only, for HogQL dashboard queries)
# Generate at: https://us.posthog.com/settings/user-api-keys
# Required scopes: query:read
POSTHOG_PERSONAL_API_KEY=phx_your-posthog-personal-api-key
POSTHOG_PROJECT_ID=your-project-id

# ==============================================================================
# Private Dashboard Access (Strict single-account authorization)
# ==============================================================================
DASHBOARD_ALLOWED_EMAIL=your-email@example.com
DASHBOARD_PASSWORD=your-secure-dashboard-password

# Session Encryption Secret (Random 32+ characters string, e.g. `openssl rand -hex 32`)
AUTH_SECRET=your-32-character-secret-key-change-me

# ==============================================================================
# Email Configuration (Contact Form)
# ==============================================================================
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# ==============================================================================
# Site URL
# ==============================================================================
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app/
