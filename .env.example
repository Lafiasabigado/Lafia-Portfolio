# ==============================================================================
# Umami Analytics & Dashboard Configuration
# ==============================================================================

# Script URL & Website ID loaded on public pages
# For Umami Cloud: https://cloud.umami.is/script.js
# For self-hosted: https://your-umami-domain.com/script.js
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-umami-website-id

# Umami API Base URL
# For Umami Cloud: https://api.umami.is/v1
# For self-hosted: https://your-umami-domain.com/api
UMAMI_API_BASE_URL=https://api.umami.is/v1

# Authentication mode 1: Umami Cloud (API Key)
UMAMI_API_KEY=your-umami-api-key

# Authentication mode 2: Self-hosted (Username + Password)
# UMAMI_USERNAME=admin
# UMAMI_PASSWORD=your-umami-password

# Private Dashboard Access (Strict single-account authorization)
DASHBOARD_ALLOWED_EMAIL=lafiasabigado@gmail.com
DASHBOARD_PASSWORD=your-secure-dashboard-password

# Session Encryption Secret (Random 32+ characters string, e.g. `openssl rand -hex 32`)
AUTH_SECRET=your-32-character-secret-key-change-me

# Optional: Enable Mock Data for local testing without connecting to Umami
# UMAMI_MOCK=false
